---
interface Props {
  content: string;
  author: string;
  title?: string;
  cite: string;
}

const { content, author, title, cite } = Astro.props;

const citationUrl = URL.canParse(cite) ? new URL(cite) : undefined;
const source = citationUrl?.hostname.replace(/^www\./, "") || cite;

const favicon = `https://s2.googleusercontent.com/s2/favicons?domain_url=${encodeURIComponent(cite)}&sz=64`;
---

<figure
  class="flex flex-col mt-2 mb-4 rounded-lg border border-gray-400 dark:border-gray-700"
>
  <blockquote
    class="border-0 p-5 m-0 border-b border-gray-400 dark:border-gray-700"
    cite={cite}
    aria-label={`Quotation by ${author}`}
  >
    {content}
  </blockquote>

  <figcaption class="m-0">
    <a
      class="flex flex-row items-center gap-3 w-full px-4 py-3"
      href={cite}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Read the full text on ${source} (opens in a new tab)`}
    >
      <span class="" aria-hidden="true">
        <img
          class=""
          src={favicon}
          alt=""
          width="24"
          height="24"
          loading="lazy"
          referrerpolicy="no-referrer"
        />
      </span>

      <span class="not-italic font-medium">{author}</span> &sdot; “{title}”
    </a>
  </figcaption>
</figure>
